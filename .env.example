# ==============================================================================
# GovOS — Master Environment Variable Template (.env.example)
# IMPORTANT: Copy this file to .env and replace dummy values before running.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Environment Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Security: JWT Token Configuration (Must be min 32 characters long random string in production)
JWT_SECRET=govos_jwt_dev_secret_minimum_32_characters_long_please_change_in_prod
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=govos_db
DB_USER=govos_user
DB_PASSWORD=govos_dev_secret
DB_POOL_MIN=2
DB_POOL_MAX=10

# Spring Boot Data Source (govos-core-api)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/govos_db
SPRING_DATASOURCE_USERNAME=govos_user
SPRING_DATASOURCE_PASSWORD=govos_dev_secret

# ------------------------------------------------------------------------------
# Redis Cache & Event Bus (govos-realtime / govos-core-api / govos-ai)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3003
SOCKET_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3003

# ------------------------------------------------------------------------------
# File Uploads & Cloud Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Notification Gateways (Optional for local dev)
# ------------------------------------------------------------------------------
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=GOVOS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password
