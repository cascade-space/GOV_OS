## Project Identity

- **Service:** GovOS Web OS Frontend
- **Language:** TypeScript (strict)
- **Framework:** React 18 + Vite 5
- **State (global):** Zustand 4.x
- **State (server):** TanStack Query v5 (React Query)
- **Styling:** Tailwind CSS v3 + shadcn/ui
- **Animations:** Framer Motion
- **Maps:** react-leaflet + Leaflet.js
- **Charts:** Recharts
- **Forms:** react-hook-form + Zod
- **HTTP:** Axios (configured in `src/lib/api.ts`)
- **WebSocket:** Socket.IO Client (singleton in `src/lib/socket.ts`)
- **Port (dev):** 5173

---

## Directory Structure Law

```
src/
  ├── router/routes.tsx         ← ALL routes declared here
  ├── shell/                    ← OS Shell (persistent, never unmounts)
  ├── features/{name}/          ← Feature modules (see pattern below)
  ├── store/                    ← Zustand slices
  ├── lib/                      ← api.ts, socket.ts, query-client.ts
  ├── components/               ← Shared reusable components
  │   ├── ui/                   ← shadcn/ui components
  │   ├── map/                  ← Leaflet wrappers
  │   └── charts/               ← Recharts wrappers
  └── types/                    ← Global TypeScript type definitions
```

## Feature Module Pattern (MANDATORY)

```
src/features/{feature}/
  ├── components/
  │   ├── {Feature}List.tsx     ← Table/list view (shadcn DataTable)
  │   ├── {Feature}Detail.tsx   ← Detail view
  │   ├── {Feature}Form.tsx     ← Create/edit form
  │   └── {Feature}Skeleton.tsx ← Loading placeholder
  ├── hooks/
  │   ├── use{Feature}Query.ts  ← TanStack Query (list + detail)
  │   ├── use{Feature}Mutation.ts ← TanStack Mutation (CRUD)
  │   └── use{Feature}Realtime.ts ← Socket.IO subscription
  ├── api/
  │   └── {feature}.api.ts      ← Axios API functions
  ├── types.ts                  ← TypeScript interfaces + Zod schemas
  └── index.tsx                 ← Module entry + route registration
```

---

## Code Generation Rules

### TypeScript
- `strict: true` in `tsconfig.json`
- No `any` — ever. Use `unknown` with type guards if needed
- All component props: typed `interface Props { ... }`
- All API responses: typed with Zod schema validation
- Prefer `type` for unions/intersections, `interface` for object shapes

### React Components
```tsx
// Every component structure:
interface Props {
  // explicit props
}

export const ComponentName: React.FC<Props> = ({ prop1, prop2 }) => {
  // hooks first
  // handlers second
  // render last
  return <div>...</div>;
};

// Named exports only (no default exports except for lazy-loaded modules)
```

### TanStack Query (Server State)
```typescript
// List query pattern:
export const useComplaintsQuery = (filters: ComplaintFilters) => {
  return useQuery({
    queryKey: ['complaints', filters],
    queryFn: () => complaintsApi.list(filters),
    staleTime: 30_000,  // 30 seconds
  });
};

// Mutation pattern:
export const useUpdateComplaintStatus = () => {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: complaintsApi.updateStatus,
    onSuccess: (_, variables) => {
      queryClient.invalidateQueries({ queryKey: ['complaints'] });
      queryClient.invalidateQueries({ queryKey: ['complaint', variables.id] });
      toast.success('Status updated');
    },
    onError: (error) => toast.error(error.message),
  });
};
```

### Socket.IO Real-time
```typescript
// Real-time hook pattern (always clean up):
export const useComplaintsRealtime = () => {
  const queryClient = useQueryClient();
  
  useEffect(() => {
    const handleStatusChanged = ({ id, toStatus }: StatusChangedEvent) => {
      queryClient.setQueryData(['complaint', id], (old: Complaint | undefined) =>
        old ? { ...old, status: toStatus } : old
      );
      queryClient.invalidateQueries({ queryKey: ['complaints'] });
    };
    
    socket.on('complaint:status_changed', handleStatusChanged);
    return () => { socket.off('complaint:status_changed', handleStatusChanged); };
  }, [queryClient]);
};
```

### Zustand Stores
```typescript
// Store slice pattern:
interface AuthState {
  user: User | null;
  token: string | null;  // Access token IN MEMORY ONLY
  tenant: Tenant | null;
  setAuth: (user: User, token: string, tenant: Tenant) => void;
  clearAuth: () => void;
}

export const useAuthStore = create<AuthState>((set) => ({
  user: null, token: null, tenant: null,
  setAuth: (user, token, tenant) => set({ user, token, tenant }),
  clearAuth: () => set({ user: null, token: null, tenant: null }),
}));
```

### Forms (react-hook-form + Zod)
```typescript
const schema = z.object({
  title: z.string().min(5, "Title must be at least 5 characters"),
  description: z.string().min(10, "Description is required"),
  priority: z.enum(["CRITICAL", "HIGH", "MEDIUM", "LOW"]),
});

const form = useForm<z.infer<typeof schema>>({
  resolver: zodResolver(schema),
  defaultValues: { priority: "MEDIUM" },
});
```

