# GovOS — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ====================================================================
# DATABASE
# ====================================================================
POSTGRES_PASSWORD=your_strong_postgres_password_here

# ====================================================================
# REDIS
# ====================================================================
REDIS_PASSWORD=your_strong_redis_password_here

# ====================================================================
# MINIO (S3-compatible object storage)
# ====================================================================
MINIO_ACCESS_KEY=your_minio_admin_username
MINIO_SECRET_KEY=your_strong_minio_password_here

# ====================================================================
# OPENSEARCH
# ====================================================================
OPENSEARCH_PASSWORD=YourStrong_OpenSearch_Password_2024!

# ====================================================================
# SECURITY
# ====================================================================
# Must be at least 32 characters for HS256 JWT signing
JWT_SECRET=replace_with_minimum_32_char_random_secret_key_here

# Shared secret for inter-service authentication
INTERNAL_SERVICE_KEY=replace_with_strong_internal_service_key

# ====================================================================
# GOOGLE CLOUD (for AI Service)
# ====================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-south1

# ====================================================================
# NOTIFICATION PROVIDERS (optional for dev, required for prod)
# ====================================================================

# MSG91 (SMS)
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=GOVOS

# SendGrid (Email)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Firebase (Push Notifications)
# Path to Firebase service account JSON credentials
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# ====================================================================
# FRONTEND (govos-web .env.local)
# ====================================================================
VITE_API_URL=http://localhost:80/api
VITE_WS_URL=http://localhost:80
VITE_MAPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
