# These tools are called by Gemini autonomously — ALL READ-ONLY:

async def query_complaints(
    tenant_id: str,
    ward_id: str | None = None,
    status: str | None = None,
    category: str | None = None,
    limit: int = 10
) -> list[dict]:
    """Query complaint records for AI analysis."""
    # Executes parameterized read-only PostgreSQL query
    
async def get_officer_workload(officer_id: str) -> dict:
    """Get current workload statistics for an officer."""

async def get_ward_statistics(ward_id: str, period_days: int = 30) -> dict:
    """Get aggregated complaint and resolution statistics for a ward."""

async def search_documents(query: str, tenant_id: str, limit: int = 5) -> list[dict]:
    """Full-text search across OpenSearch document index."""

async def get_project_status(project_id: str) -> dict:
    """Get current status, milestones, and budget for a project."""
```

