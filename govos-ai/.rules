## Code Generation Rules

### FastAPI Routes
```python
# All routes MUST follow this pattern:
@router.post("/ai/classify", response_model=ClassificationResponse)
@limiter.limit("100/minute")
async def classify_complaint(
    request: ClassifyRequest,
    _: UUID = Depends(verify_internal_or_jwt_token),  # auth dependency
    db: AsyncSession = Depends(get_db),
) -> ClassificationResponse:
    """
    Classify a complaint's category and priority using Gemini.
    Called internally by Spring Boot on complaint creation.
    """
    return await ai_service.classify(request)
```

### Pydantic Models (v2)
```python
from pydantic import BaseModel, Field, UUID4

class ClassifyRequest(BaseModel):
    complaint_id: UUID4
    tenant_id: UUID4
    title: str = Field(..., min_length=5, max_length=500)
    description: str = Field(..., min_length=10, max_length=5000)
    
class ClassificationResponse(BaseModel):
    complaint_id: UUID4
    category: str
    priority: Literal["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    confidence_score: float = Field(ge=0.0, le=1.0)
    reasoning: str
```

### Gemini AI Integration
```python
# Use google.genai — NEVER openai or anthropic
from google import genai
from google.genai import types

client = genai.Client(project=settings.GCP_PROJECT_ID, location=settings.GCP_LOCATION)

# For fast classification tasks:
MODEL_FAST = "gemini-2.0-flash"

# For reasoning-heavy tasks:
MODEL_PRO = "gemini-1.5-pro"

# Auto Function Calling pattern:
response = await client.aio.models.generate_content(
    model=MODEL_PRO,
    contents=user_message,
    config=types.GenerateContentConfig(
        system_instruction=system_prompt,
        tools=[query_complaints, get_officer_workload, search_documents],
        automatic_function_calling=types.AutomaticFunctionCallingConfig(disable=False)
    )
)
```

### Prompt Files
- All system prompts MUST live in `/app/prompts/` as `.txt` files
- Load with `prompt_manager.get_prompt("classify_complaint")`
- Never hardcode prompts inline in service code
- Prompts include: role context, output format specification (JSON), constraints

### Geo Intelligence
```python
# Ward resolution pattern:
import geopandas as gpd
from shapely.geometry import Point

async def resolve_ward(lat: float, lon: float, tenant_id: UUID) -> WardResolution:
    # 1. Fetch ward GeoJSON boundaries from Spring Boot API (cached 1hr in Redis)
    boundaries = await ward_cache.get_or_fetch(tenant_id)
    gdf = gpd.GeoDataFrame.from_features(boundaries)
    
    # 2. Point-in-polygon spatial join
    point = Point(lon, lat)
    result = gdf[gdf.geometry.contains(point)]
    
    if result.empty:
        raise WardNotFoundError(f"No ward found for coordinates ({lat}, {lon})")
    
    return WardResolution(ward_id=result.iloc[0]["wardId"], ...)
```

### Allocation Engine
```python
# Workload balancing algorithm:
async def assign_complaint(complaint_id: UUID, ward_id: UUID, priority: str) -> UUID:
    # 1. Fetch officers in the ward with active ticket load
    officers = await db.fetch(
        "SELECT officer_id, active_count, avg_sla_score FROM v_officer_workload "
        "WHERE ward_id = $1 AND is_available = TRUE",
        ward_id
    )
    
    # 2. Weight by: active_count (lower = better) + SLA proximity (lower = better)
    # 3. Assign to officer with lowest weighted score
    optimal = min(officers, key=lambda o: o.active_count * (1 + o.sla_urgency_factor))
    
    # 4. Publish assignment event to Redis
    await redis.publish("govos:events", json.dumps({
        "type": "complaint:assigned",
        "tenantId": str(tenant_id),
        "payload": {"complaintId": str(complaint_id), "officerId": str(optimal.officer_id)}
    }))
    
    return optimal.officer_id
```

